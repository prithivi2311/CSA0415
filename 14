
#include <stdio.h>
#include <string.h>

int main()
{
    char files[20][30], name[30];
    int n = 0, choice, i, found;

    while(1)
    {
        printf("\n1.Create File");
        printf("\n2.Search File");
        printf("\n3.Delete File");
        printf("\n4.Display Files");
        printf("\n5.Exit");
        printf("\nEnter choice: ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                printf("Enter file name: ");
                scanf("%s", name);
                found = 0;

                for(i = 0; i < n; i++)
                    if(strcmp(files[i], name) == 0)
                        found = 1;

                if(found)
                    printf("File already exists");
                else
                {
                    strcpy(files[n++], name);
                    printf("File created");
                }
                break;

            case 2:
                printf("Enter file name: ");
                scanf("%s", name);
                found = 0;

                for(i = 0; i < n; i++)
                    if(strcmp(files[i], name) == 0)
                        found = 1;

                if(found)
                    printf("File found");
                else
                    printf("File not found");
                break;

            case 3:
                printf("Enter file name: ");
                scanf("%s", name);
                found = 0;

                for(i = 0; i < n; i++)
                {
                    if(strcmp(files[i], name) == 0)
                    {
                        for(int j = i; j < n - 1; j++)
                            strcpy(files[j], files[j + 1]);
                        n--;
                        found = 1;
                        break;
                    }
                }

                if(found)
                    printf("File deleted");
                else
                    printf("File not found");
                break;

            case 4:
                printf("Files in directory:\n");
                for(i = 0; i < n; i++)
                    printf("%s\n", files[i]);
                break;

            case 5:
                return 0;

            default:
                printf("Invalid choice");
        }
    }
}
