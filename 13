
#include <stdio.h>

int main()
{
    int block[10], process[10], allocation[10];
    int nb, np, i, j, choice, best;

    printf("Enter number of blocks: ");
    scanf("%d", &nb);

    printf("Enter block sizes:\n");
    for(i = 0; i < nb; i++)
        scanf("%d", &block[i]);

    printf("Enter number of processes: ");
    scanf("%d", &np);

    printf("Enter process sizes:\n");
    for(i = 0; i < np; i++)
        scanf("%d", &process[i]);

    printf("1.First Fit  2.Best Fit  3.Worst Fit\n");
    printf("Enter choice: ");
    scanf("%d", &choice);

    for(i = 0; i < np; i++)
        allocation[i] = -1;

    for(i = 0; i < np; i++)
    {
        best = -1;

        for(j = 0; j < nb; j++)
        {
            if(block[j] >= process[i])
            {
                if(choice == 1)
                {
                    best = j;
                    break;
                }
                else if(choice == 2)
                {
                    if(best == -1 || block[j] < block[best])
                        best = j;
                }
                else if(choice == 3)
                {
                    if(best == -1 || block[j] > block[best])
                        best = j;
                }
            }
        }

        if(best != -1)
        {
            allocation[i] = best;
            block[best] -= process[i];
        }
    }

    printf("\nProcess\tSize\tBlock\n");
    for(i = 0; i < np; i++)
    {
        printf("%d\t%d\t", i + 1, process[i]);
        if(allocation[i] != -1)
            printf("%d\n", allocation[i] + 1);
        else
            printf("Not Allocated\n");
    }

    return 0;
}
